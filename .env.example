# ========================================================
# Marriage Hall Management System (MHMS)
# Production Environment Variables Template for Vercel
# ========================================================

# Neon PostgreSQL Database URL (Use your Neon connection string)
neon_databasr_key=postgresql://user:password@ep-your-cluster.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://user:password@ep-your-cluster.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Django Security Settings
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-for-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# Frontend API URL (Optional - defaults to relative /api/v1 on Vercel)
VITE_API_BASE_URL=/api/v1
